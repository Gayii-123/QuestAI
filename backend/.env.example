# ==============================================================================
# QuestAI Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' for local development.
# IMPORTANT: DO NOT commit actual secrets or the '.env' file to Git.
# ==============================================================================

# Server Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port for Local Development
PORT=5001

# Allowed Frontend Origin for CORS (Angular local dev server)
FRONTEND_URL=http://localhost:4200

# Express Request Body Size Limit (photos are sent as base64 in later phases)
MAX_REQUEST_SIZE=50mb

# ------------------------------------------------------------------------------
# Google Gemini via Google Cloud Agent Platform (Vertex AI, API-key / Express mode)
# ------------------------------------------------------------------------------
# API key created in Google Cloud Console > APIs & Services > Credentials
GEMINI_API_KEY=your_gemini_api_key_placeholder
# Model ID to use (must be available on the Agent Platform endpoint)
GEMINI_MODEL=gemini-3.8-flash
# Google Cloud project ID (Console > project picker > ID column)
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
# Location, normally 'global'
GOOGLE_CLOUD_LOCATION=global
