# ==============================================================================
# QuestAI Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' for local development.
# IMPORTANT: DO NOT commit actual secrets or the '.env' file to Git.
# ==============================================================================

# Server Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port for Local Development
PORT=5001

# Allowed Frontend Origin for CORS (Angular local dev server)
FRONTEND_URL=http://localhost:4200

# Express Request Body Size Limit (e.g., '10mb' for site inspection data/payloads)
MAX_REQUEST_SIZE=10mb

# Google Gemini API Key (Placeholder - to be configured when AI analysis is enabled)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_placeholder

